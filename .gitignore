# --- Entornos virtuales -------------------------------------------------------
.venv/
venv/
env/

# --- Salidas de ejecución -----------------------------------------------------
# Alertas y evidencia: contienen imágenes de personas (Ley N.º 29733).
outputs/
runs/

# --- Datos ----------------------------------------------------------------------
# Videos e imágenes de escenas reales: NUNCA se versionan (privacidad y peso).
# La estructura esperada se documenta en data/README.md.
data/*
!data/README.md
datasets/
stairs_fallhuman/
Escaleras/
escalera/
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v
*.mpeg
*.mpg
*.wmv
capturas/
pruebas/
Fase*.png
Fase*.jpg
img_prueba*
test_img*

# --- Pesos de modelos ------------------------------------------------------------
# Solo se versionan los pesos propios del proyecto y el COCO que usa el motor.
# Los de Real-ESRGAN se descargan con tools/download_models.py.
*.pt
*.pth
*.onnx
!models/detector/escaleras_s7_v4.pt
!models/coco/yolov8s.pt
!models/base/yolov8s_zoom_v3.pt

# --- Secretos ------------------------------------------------------------------
# PANEL_TOKEN (RQNF19) se lee de una variable de entorno, nunca del repo.
.env
.env.*
*.pem
*.key
*.p12
kaggle.json

# --- Documentos temporales de Office -------------------------------------------
~$*.docx
.~lock.*

# --- Python / sistema / editores -------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store
Thumbs.db
.kilo/
.vscode/
.idea/
